rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ──────────────────────────────────────────────────────────────
    // CUSTOM CLAIMS (request.auth.token.admin)
    //
    // Migração concluída (functions/sincronizarClaimsNoDoc + backfill).
    // isAdmin() usa o claim custom (request.auth.token.admin) e, como FALLBACK
    // transitório, lê o doc users/{uid} — admins cujas sessões ainda não relogaram.
    // Fonte da verdade: o doc users/{uid} — atualizado por triggers (DB) e Functions.
    //
    // Deploy (em ordem — NUNCA inverter):
    //   1. Deploy functions/  (trigger + sincronizarClaimsAdmin)
    //   2. Rodar sincronizarClaimsAdmin UMA vez (backfill)
    //   3. Todos os admins relogam (token cacheado não tem o claim)
    //   4. Deploy rules (THIS FILE) + storage.rules
    //
    // Rollback (se necessário):
    //   Reverter este arquivo ao commit anterior (isAdmin via get/exists).
    //   Reverta storage.rules simultaneamente.
    //
    // ── Funções utilitárias ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MASTER'))
      );
    }

    // Administrador PRINCIPAL. Decisão baseada SOMENTE no campo mainAdmin do
    // doc users/{uid} (bloqueado para escrita no cliente). NUNCA em email/id —
    // que eram graváveis pelo próprio usuário e permitiam elevação de conta.
    // O claim custom `principal` (definido só pelo servidor) é aceito como fonte
    // adicional e à prova de escrita de cliente.
    function ehPrincipal() {
      return isAuthenticated() && (
        request.auth.token.principal == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mainAdmin == true)
      );
    }

    // Vendedor / operador de caixa: claim custom `vendedor` (token) com FALLBACK
    // transitório ao doc users/{uid} (mesmo padrão do isAdmin). O vendedor é a
    // "equipe lite": acesso de leitura ao PDV, pedidos, produtos e caixa PRÓPRIO.
    function isVendedor() {
      return isAuthenticated() && (
        request.auth.token.vendedor == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendedor' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'VENDEDOR' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OPERATOR'))
      );
    }

    // Equipe do painel (admin OU vendedor/operador).
    function isEquipe() {
      return isAdmin() || isVendedor();
    }

    // O usuário é dono de um registro quando: id == UID autenticado,
    // OU o documento do usuário naquele id possui authUid == UID autenticado
    // (cobre usuários legados que ainda têm id antigo).
    function userMatch(userId) {
      return isAuthenticated() && (
        userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
         get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid)
      );
    }

    // ── USUÁRIOS ──
    // Leitura: próprio usuário ou admin. Criação: SOMENTE via Cloud Function.
    // Atualização: admin sobre OUTROS usuários (exceto campos sensíveis) ou o
    // próprio usuário APENAS em campos de perfil seguros. Campos sensíveis
    // (role, walletBalance, weeklySpent, authUid, mainAdmin, isMainAdmin,
    // permissions) só mudam via Cloud Functions (admin SDK, ignora as regras).
    // NUNCA é permitido ao usuário alterar role, walletBalance, weeklySpent ou authUid.
    // BLINDAGEM DE ELEVAÇÃO: mesmo sendo admin, o próprio doc cai na whitelist de
    // perfil — impede um admin secundário de gravar permissions:['all'] ou alterar
    // o próprio status via cliente (elevação que contornava exigirAdminPermissao).
    // diff().affectedKeys() garante que só os campos permitidos MUDAM (hasOnly no doc
    // inteiro quebraria qualquer update, pois o doc contém campos fora da lista).
    match /users/{userId} {
      allow get: if isAuthenticated() && (userId == request.auth.uid || resource.data.authUid == request.auth.uid || isEquipe());
      // list: equipe autenticada (admin OU vendedor). O painel administrativo
      // precisa da lista completa para a aba Usuários, a busca de clientes no
      // PDV (vendedor inclui) e relatórios. NÃO liberado para usuário comum:
      // listar TODOS os usuários vazaria PII (CPF, saldo, role). A busca do
      // perfil do usuário logado segue via Cloud Function buscarUsuarioAtual.
      allow list: if isEquipe();
      allow create: if false;
      allow update: if (isAdmin() && userId != request.auth.uid &&
        // 'saqueDia' entrou na lista porque é o contador do teto diário de saque
        // (R$ 1.000/dia em sacarSaldoProprio, que só exige autenticação — sem
        // senha mestra). Bastava um update para zerar o contador de qualquer
        // usuário e sacar acima do teto. Só a Cloud Function grava o campo, na
        // mesma transação do débito.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'walletBalance', 'weeklySpent', 'authUid', 'mainAdmin',
          'isMainAdmin', 'permissions', 'saqueDia', 'creditLimit',
          'autorizacaoExcepcional'
          // 'currentDebt' NÃO está na lista acima porque o fallback offline de
          // recebimento de fiado (utils/customerUtils.ts -> abateDivida) precisa
          // abater a dívida quando o backend está inacessível. Em vez de liberar
          // o campo, ele é restringido ABAIXO a "só pode baixar".
        ]) &&
        // CORREÇÃO DE SEGURANÇA: currentDebt só pode DIMINUIR.
        // Antes, o campo ficava livre para escrita do cliente e
        // updateCustomerAccount() (utils/customerUtils.ts) é um writer genérico:
        // bastava chamar {currentDebt: 999999} para inflar a dívida de qualquer
        // cliente, e um admin sem a permissão 'finance' faria isso — a Cloud
        // Function exigiria 'finance' e recusaria, mas o cliente passava.
        // Por que "só baixar" não quebra fluxo legítimo:
        //  - abateDivida valida `valor > dividaAtual -> throw`, logo escreve
        //    sempre um valor MENOR ou igual ao anterior;
        //  - a UI admin (AdminCustomersTab.handleSave) NUNCA envia currentDebt
        //    em update (só em create, que é bloqueado por `allow create: if false`);
        //  - O teto de divida continua vindo da Function, que e a
        //    autoridade real (valida currentDebt + creditLimit atomicamente).
        //  - weeklySpent segue bloqueado (consumo semanal e' do servidor).
        //
        // creditLimit: AGORA BLOQUEADO no cliente (linha 98 acima). Edicao de limite
        // de credito deve passar pela Callable `atualizarLimiteCredito` (finance +
        // senha mestra). A UI (AdminCustomersTab) foi migrada para chamar a Function.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentDebt'])
          || (request.resource.data.currentDebt is number
              && request.resource.data.currentDebt >= 0
              && request.resource.data.currentDebt
                 <= (resource.data.currentDebt is number ? resource.data.currentDebt : 0)))
        ) ||
        (userMatch(userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'phone', 'avatarUrl', 'inmateName', 'inmateCpf',
           'prisonerName', 'prisonerCpf', 'documentUrl',
           'showFinanceEntries', 'selectedUnitId'
         ]));
         // SEGURANÇA: 'email' foi REMOVIDO da whitelist de auto-update. Antes, o
         // próprio usuário podia gravar email no doc; como exigirAdminPrincipal
         // tratava 'admin@mercado.com' como principal, QUALQUER admin secundário
         // virava principal mudando o próprio email (tomada de conta). O email
         // agora só é definido no signup (criação, via Cloud Function) e o
         // privilégio principal usa exclusivamente o campo mainAdmin.
      // SEM HARD DELETE: a exclusão de usuário é SOFT e passa pelo servidor
      // (excluirUsuario / excluirClienteFiado: soft delete + audit log). Um
      // deleteDoc direto do navegador apagava a ficha, o saldo e todo o
      // histórico de compras do cliente — sem rastro de auditoria.
      allow delete: if false;
    }

    // ── PEDIDOS ──
    // Criação: SOMENTE via Cloud Functions (registrarPedidoPix, comprarComCarteira,
    // processarVendaAdmin) — o SDK admin ignora estas regras. Criação bloqueada no
    // cliente para impedir pedido PIX "PENDENTE" forjado (total/items arbitrarios)
    // que o admin aprovaria depois (SEGURANCA: compra fake por R$ 0,01, estoque
    // jamais debitado). Atualizacao: admin (tudo) ou o dono do pedido PENDENTE —
    // e APENAS o campo paymentProofUrl (reenvio automatico do comprovante).
    match /orders/{orderId} {
      allow create: if false; // venda via backend (Cloud Functions)
      allow read: if isAuthenticated() && (userMatch(resource.data.userId) || isEquipe());
      // Admin só altera, pelo CLIENTE, os campos OPERACIONAIS que a UI realmente
      // grava (updateOrderStatus, markOrderAsPrinted, archiveData). Tudo que é
      // dinheiro ou vínculo — total, paymentMethod, userId, items, userCpf — fica
      // fora: ou passa pelas Cloud Functions (que usam admin SDK e ignoram estas
      // regras), ou é bloqueado. Sem este affectedKeys, uma sessão admin
      // comprometida no navegador reescrevia o total de qualquer pedido.
      allow update: if (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'printCount', 'deleted'])
        // Status TERMINAL (cancelado/rejeitado/estornado/devolvido) NUNCA é
        // gravado pelo cliente: o estorno devolve estoque, carteira, fiado e
        // gaveta e é auditado no SERVIDOR. No cliente só o status OPERACIONAL
        // (andamento/entrega) pode ser escrito. A UI (updateOrderStatus) já
        // recusava os terminais, mas a barreira era SÓ no cliente: bastava um
        // updateDoc direto pelo console do navegador para marcar um pedido pago
        // como "cancelled" e zerar o estoque sem devolver nada a ninguem.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in [
               'preparing', 'separacao', 'out_for_delivery', 'delivered', 'entregue',
               'paid', 'pago'
             ]
        )
      ) || (
        // Comprovante de pagamento do próprio pedido, somente enquanto pendente.
        userMatch(resource.data.userId)
        && resource.data.status.matches('(?i)^pending$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl', 'proofHash', 'proofSize', 'proofMime'])
      );
      // SEM HARD DELETE: pedido é arquivado (soft: deleted=true) pelo admin ou
      // pelo servidor. Apagar o doc sumia com a venda da conciliação e da
      // auditoria — e a limpeza definitiva é do backend (arquivar/limpar).
      allow delete: if false;
    }

    // ── TRANSAÇÕES DE CARTEIRA ──
    // Criação: usuário só abre depósito PENDENTE próprio.
    // Movimentação de saldo: APENAS via Cloud Functions.
    match /wallet_transactions/{txId} {
      allow create: if isAuthenticated()
        && userMatch(request.resource.data.userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.type == 'deposit'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if isAuthenticated() && (userMatch(resource.data.userId) || isAdmin());
      // Reenvio automático do comprovante (upload offline): o dono só pode
      // preencher proofUrl enquanto a transação estiver pendente.
      allow update: if isAdmin() || (
        userMatch(resource.data.userId)
        && resource.data.status.matches('(?i)^pending$')
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUrl', 'proofHash', 'proofSize', 'proofMime'])
      );
      // SEM HARD DELETE: movimentação de carteira é dinheiro. Depósito, estorno
      // e ajuste são do SERVIDOR (com trilha). Apagar a transação do navegador
      // apagava a dívida do cliente sem o saldo mudar — o dinheiro evaporava.
      allow delete: if false;
    }

    // ── PRODUTOS ──
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── CONFIGURAÇÕES ──
    // Docs permitidos: 'general' (público, SEM senhas), 'private' (hash da senha mestra),
    // 'maintenance' (controle de rotinas). Matches explícitos (regras são OR — um match
    // genérico anularia as restrições abaixo).
    match /settings/general {
      allow read: if isAuthenticated();
      // SEGURANÇA: campos que desviam DINHEIRO ficam fora da escrita do cliente.
      // - pixKeys / pixKey: o app do familiar exibe esta chave como destino do
      //   PIX; um admin secundário podia trocá-la pela própria conta e desviar
      //   todos os depósitos (o servidor não valida o destino recebido).
      // - weeklyWalletLimit: lido pelo servidor como teto de gasto; um admin
      //   podia elevar para bilhões e burlar o limite semanal.
      // - institutionName/tradeName: aparecem no cupom/recibo (spoofing).
      // - saleEnabled: desliga o botão de venda do PDV (kill switch operacional).
      // - adminMessage/adminMessage*: aviso global do principal aos demais
      //   admins; só o principal pode publicar/limpar.
      // Alterações legítimas passam pelas Cloud Functions (admin SDK, ignora
      // estas regras) ou por um admin PRINCIPAL autenticado.
      allow update: if isAdmin()
        && !request.resource.data.keys().hasAny(['secondaryPassword', 'adminPassword'])
        && (ehPrincipal()
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'pixKeys', 'pixKey', 'weeklyWalletLimit', 'institutionName', 'tradeName',
                 'saleEnabled', 'adminMessage', 'adminMessageUpdatedAt', 'adminMessageBy'
               ]));
      allow create: if isAdmin()
        && !request.resource.data.keys().hasAny(['secondaryPassword', 'adminPassword'])
        && (ehPrincipal()
            || !request.resource.data.keys().hasAny([
                 'pixKeys', 'pixKey', 'weeklyWalletLimit', 'institutionName', 'tradeName',
                 'saleEnabled', 'adminMessage', 'adminMessageUpdatedAt', 'adminMessageBy'
               ]));
      allow delete: if false;
    }
    match /settings/private {
      // Nunca acessível ao cliente (hash da senha mestra): somente a Cloud
      // Function definirSenhaMestra (admin SDK, ignora as regras) escreve aqui,
      // e nenhuma leitura client-side é necessária.
      allow read, write: if false;
      allow delete: if false;
    }
    match /settings/maintenance {
      // Controle de manutenção (sistema desativado para outros admins):
      // leitura para qualquer autenticado (admins bloqueados precisam ver o motivo),
      // escrita SOMENTE admin, com campos e tipos forçados. Exclusão proibida.
      // NOTA: a Cloud Function backupAutomaticoDiario usa admin SDK e ignora estas rules.
      allow read: if isAuthenticated();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'ativo', 'motivo', 'desativadoPor', 'desativadoPorNome', 'desativadoEm',
          'lastWeeklyReset'
        ])
        && request.resource.data.ativo is bool
        && (!('motivo' in request.resource.data) || request.resource.data.motivo is string)
        && (!('desativadoPor' in request.resource.data) || request.resource.data.desativadoPor is string)
        && (!('desativadoPorNome' in request.resource.data) || request.resource.data.desativadoPorNome is string)
        && (!('desativadoEm' in request.resource.data) || request.resource.data.desativadoEm is string)
        && (!('lastWeeklyReset' in request.resource.data) || request.resource.data.lastWeeklyReset is string);
      allow delete: if false;
    }
    match /settings/checklist {
      // Checklist de manutenção (Centro de Manutenção).
      // Qualquer autenticado pode ler (todos os admins enxergam o mesmo estado);
      // admin pode escrever apenas o campo realizacoes (map de itemId → {realizadaEm, por}).
      allow read: if isAuthenticated();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['realizacoes'])
        && request.resource.data.realizacoes is map;
      allow delete: if false;
    }

    // ── SEGREDOS DE AUTENTICAÇÃO (hash legado de senha) ──
    // Hash bcrypt de senha. NUNCA pelo cliente: enquanto a regra era
    // `allow read, write, delete: if isAdmin()`, qualquer admin — inclusive um
    // admin secundário SEM as permissões users/finance — lia todos os hashes via
    // Web SDK, o que anulava na prática a checagem de permissão da Cloud Function
    // e abria caminho para quebra offline de senha. O servidor (Admin SDK, que
    // ignora estas regras) é o único consumidor: ver obterHashLegado/gravarHash
    // em functions/index.js.
    match /auth_secrets/{uid} {
      allow read, write, delete: if false;
    }

    // ── SESSÕES DE CAIXA ──
    // Leitura: o próprio operador, o caixa que ele opera, ou equipe
    // (admin/vendedor — o vendedor vê o próprio histórico). Escrita: PROIBIDA
    // no cliente — TODA mutação passa pela Cloud Function gerenciarSessaoCaixa
    // (admin SDK, autoritativa: confere papel, dono e atomicidade).
    match /cash_sessions/{sessionId} {
        // Leitura: o próprio operador SEMPRE (abrir/fechar a sessão dele e o
        // comprovante de fechamento), e o admin em qualquer sessão.
        // Antes era isEquipe() (= admin OU vendedor), o que deixava QUALQUER
        // vendedor listar e ler saldo, saídas e divergência das sessões dos
        // COLEGAS — dado financeiro de terceiros. O vendedor
        // continua operando o próprio caixa normalmente; perde só a visão
        // alheia, que é de gestão.
        // ATENÇÃO: Firestore não filtra resultado de query por regra — a query
        // é rejeitada por inteiro. Por isso utils/cashSession.ts faz o
        // getRecentSessions com where("operatorId","==",<uid>) para não-admin.
        allow read: if isAuthenticated() && (userMatch(resource.data.operatorId) || isAdmin());
        allow create, update, delete: if false;
    }

    // ── TRAVAS OPERACIONAIS (abertura/fechamento atômico de caixa) ──
    // Doc de guarda lido/gravado SERVIDOR-SIDE na mesma transação da sessão.
    // Nenhum cliente (nem admin) escreve diretamente — a única porta é a Cloud
    // Function gerenciarSessaoCaixa. Exclusão proibida. Leitura também negada
    // ao cliente (não expõe o id de sessões ativas por fora da API).
    match /locks/{lockId} {
      allow read, write, delete: if false;
    }

    // ── DESPESAS ──
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // ── MENSAGENS (comunicação admin ↔ usuário) ──
    match /messages/{msgId} {
      allow read: if isAuthenticated()
        && (isAdmin()
          || userMatch(resource.data.userId)
          || resource.data.userId == 'ALL');
      allow create: if isAdmin();
      allow update: if isAuthenticated()
        && (isAdmin()
          || (userMatch(resource.data.userId) || resource.data.userId == 'ALL')
            // BUGFIX: request.resource.data é o DOC INTEIRO futuro — hasOnly
            // nele sempre falhava e o usuário nunca conseguia marcar "Lida".
            // diff() olha apenas as chaves efetivamente alteradas.
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }

    // ── MENSAGENS DO SISTEMA (avisos) ──
    match /systemMessages/{msgId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

// ── LOGS DE AUDITORIA (ações sensíveis; imutáveis) ──
    // As 4 ações de ADMIN (anexar comprovante, excluir usuário, zerar estoque,
    // zerar financeiro) foram movidas para Cloud Functions, que auditam no
    // SERVIDOR (admin SDK — ignora estas regras). O cliente NÃO escreve mais em
    // audit_logs: antes um device podia inventar uma ação que não ocorreu (o
    // Firestore não consegue atribuir autoria confiável a um write do cliente),
    // então a trilha era forjável. Agora o create do cliente é NEGADO.
    // Leitura: somente admin. Edição e exclusão: NUNCA (log imutável).
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── AUDITORIA DIÁRIA DE ANOMALIAS ──
    // Gravado pela Cloud Function auditoriaDiaria (admin SDK — ignora estas
    // regras). O painel lê via callable listarAuditorias, que valida a
    // permissão 'finance' no servidor; o acesso direto fica restrito ao admin.
    match /audit_diario/{dia} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── ALERTAS DO FIREBASE (Alert Center) ──
    // Registro imutável gravado pela Cloud Function tratarAlertasFirebase
    // (admin SDK — ignora estas regras). Cliente: somente leitura por admin.
    match /alerts_log/{alertId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // ── CAIXA FÍSICA, FORNECEDORES E PRÉ-CADASTROS ──
    // Matches explícitos (sem wildcard) — Firestore NEGA por padrão o que
    // não possui regra. Isso também impede que o wildcard conceda escrita
    // em settings/ contornando as restrições de senhas acima.
    // Coleção LEGADA de sessões de caixa. Hoje só o admin SDK (Functions) grava
// aqui; o cliente apenas migra/histórico (getDocs). Escrita liberada "por
// garantia" permitiria um cliente admin criar/editar sessão de caixa e
// adulterar o histórico — o caminho real (abrir/fechar caixa) é a Function.
match /cashier/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }
    match /pre_registered_inmates/{inmateId} {
      allow read, write: if isAdmin();
    }

    // ── ARQUIVO HISTÓRICO (pedidos e registros antigos arquivados) ──
    // Trilha de auditoria permanente: somente o admin SDK (Cloud Functions) —
    // que ignora estas regras — escreve aqui. Cliente: apenas leitura por admin.
    match /historico_geral/{recordId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
