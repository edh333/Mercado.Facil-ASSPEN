{
  "name": "mercado-facil-pdv",
  "private": true,
  "version": "1.0.6",
  "main": "desktop/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/edh333/Mercado.Facil-ASSPEN.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build --outDir dist --base=./",
    "build-mem": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5177 && electron .\"",
    "electron-build": "node scripts/build-exe.mjs",
    "electron-build:user": "node scripts/build-exe.mjs --user",
    "electron-build:admin": "node scripts/build-exe.mjs --admin",
    "build:exe": "node scripts/build-exe.mjs",
    "build:exe:user": "node scripts/build-exe.mjs --user",
    "build:exe:admin": "node scripts/build-exe.mjs --admin",
    "deploy": "firebase deploy --only hosting,firestore,storage:main,functions",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore,storage:main",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:pages": "npm run build && npx --yes wrangler pages deploy build",
    "publish:apps": "node scripts/publish-apps.cjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "compressorjs": "^1.3.0",
    "firebase": "^12.7.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.asspen.mercadofacil",
    "productName": "Mercado Facil ASSPEN",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/logo.png"
    }
  }
}
