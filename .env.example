# ── Credenciais do Firebase (copie este arquivo para .env e preencha) ──
# As variáveis VITE_* são embutidas no bundle pelo Vite durante o build.
# O arquivo .env NUNCA deve ser commitado (está no .gitignore).
# NUNCA salve este arquivo como .env (contém apenas placeholders).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Sentry (monitoramento de erros — opcional mas recomendado) ──
# 1. Crie uma conta em https://sentry.io → projeto React
# 2. Copie a DSN (formato: https://...@sentry.io/12345)
# 3. Adicione VITE_SENTRY_DSN=<valor real> no seu .env
# Sem esta variável, tudo funciona normalmente (zero custo, zero requests).
VITE_SENTRY_DSN=

# ── SEGURANÇA DA CHAVE GEMINI / IA ──
# Nenhuma chave de IA deve ser embutida no app (o Vite não injeta chaves no
# bundle). Se no futuro houver IA, ela DEVE ficar nas Cloud Functions apenas
# (process.env da runtime), nunca com prefixo VITE_.
# Antes de rotacionar qualquer chave, confirme que ela não há em:
#   - git log --all -- .env   (chaves commitadas no passado DEVEM ser
#     invalidadas/rotacionadas mesmo que trocadas depois)

# ── Publicação dos instaladores desktop (npm run publish:apps) ──
# NÃO precisa de credencial aqui: o script reusa a MESMA sessão do Firebase CLI
# (firebase login) que o deploy.bat usa. O access token do dono do projeto faz
# upload via GCS como owner e atravessa as Storage Rules sem depender de senha
# de usuário do sistema.