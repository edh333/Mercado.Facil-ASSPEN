# ── Credenciais do Firebase (copie este arquivo para .env e preencha) ──
# As variáveis VITE_* são embutidas no bundle pelo Vite durante o build.
# O arquivo .env NUNCA deve ser commitado (está no .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Chave Gemini (opcional — apenas para recursos de IA, se habilitados)
VITE_GEMINI_API_KEY=