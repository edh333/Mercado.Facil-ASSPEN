rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de produtos â€” qualquer usuÃ¡rio autenticado pode ler;
    // escrita apenas por administradores (role 'admin' no Firestore).
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'master' ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'MASTER');
    }

    function isOwner(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        (firestore.exists(/databases/(default)/documents/users/$(uid)) &&
         firestore.get(/databases/(default)/documents/users/$(uid)).data.authUid == request.auth.uid)
      );
    }

    match /products/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024   // 2MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Arquivos privados por usuÃ¡rio â€” estrutura {pasta}/{uid}/{arquivo}:
    // leitura apenas do dono (ou admin); escrita apenas do dono.

    // Comprovantes de depÃ³sito (wallet_proofs) â€” atÃ© 8MB
    match /wallet_proofs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Documentos de identidade (cadastro) â€” atÃ© 8MB
    match /docs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if isAdmin();
    }

    // Comprovantes de pagamento PIX (pedidos) â€” atÃ© 8MB
    match /comprovantes_pix/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Comprovantes diversos â€” 5MB max (apenas imagens/PDF)
    match /receipts/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Instaladores dos aplicativos desktop (pasta apps/) â€” pÃºblicos para leitura;
    // escrita apenas de arquivos .exe por qualquer usuÃ¡rio autenticado
    // (fluxo do script de publicaÃ§Ã£o).
    match /apps/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('application/octet-stream|application/x-msdownload|application/vnd.microsoft.portable-executable')
            || fileName.matches('.*\\.exe$'));
      allow delete: if false;
    }

    // Regra de seguranÃ§a (Fallback): bloqueia qualquer pasta nÃ£o listada acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
