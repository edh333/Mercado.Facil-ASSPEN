rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images: any authenticated user may read;
    // write only for admins (custom claims OR users doc).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
         (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'master' ||
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'MASTER'))
      );
    }

    function isOwner(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        (firestore.exists(/databases/(default)/documents/users/$(uid)) &&
         firestore.get(/databases/(default)/documents/users/$(uid)).data.authUid == request.auth.uid)
      );
    }

    // Explicitly SUSPENDED account. Used only to BLOCK WRITES.
    // Deliberately does NOT require status == 'active': during signup the user
    // is still 'pending' and must upload the identity document and make the
    // first deposit -- requiring 'active' would break onboarding. A suspended
    // account, however, has no reason to write: besides being unable to
    // transact anyway (exigirAutenticado rejects it in Functions), it must not
    // be able to host arbitrary content on the project's public domain
    // (abuse/phishing + Storage cost).
    function isSuspenso() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'suspended';
    }

    // Allowed to write: a non-suspended owner, or an admin.
    function podeGravar(uid) {
      return (isOwner(uid) || isAdmin()) && !isSuspenso();
    }

    // Authenticated user data (for rules that need a fine-grained check).
    function dadosUsuario() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Installer publishing (apps/ folder): besides admin, requires the explicit
    // 'apps' or 'all' permission. Main admins (admin custom claim) and legacy
    // admins without a permissions field keep full access. Prevents a restricted
    // secondary admin from replacing the distributed installer (supply-chain
    // vector).
    function isAdminPublicadora() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         dadosUsuario().status == 'active' &&
         (dadosUsuario().role == 'admin' || dadosUsuario().role == 'ADMIN' ||
          dadosUsuario().role == 'master' || dadosUsuario().role == 'MASTER') &&
         (!('permissions' in dadosUsuario()) || dadosUsuario().permissions.hasAny(['apps', 'all'])))
      );
    }

    match /products/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024   // 2MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Private per-user files -- layout {folder}/{uid}/{fileName}:
    // read only by the owner (or an admin); write only by a non-suspended owner.

    // Deposit proofs (wallet_proofs) -- up to 8MB
    match /wallet_proofs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if podeGravar(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif|webp|bmp)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Identity documents (signup) -- up to 8MB
    match /docs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if podeGravar(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif|webp|bmp)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if isAdmin();
    }

    // PIX payment proofs (orders) -- up to 8MB
    match /comprovantes_pix/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if podeGravar(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif|webp|bmp)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Miscellaneous proofs -- 5MB max (images/PDF only)
    match /receipts/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if podeGravar(uid)
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif|webp|bmp)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Desktop app installers (apps/ folder) -- publicly readable;
    // write/delete ONLY by admins (the folder must not be corrupted by a
    // regular user -- supply-chain vector).
    // Public READ only for the manifest and the USER installer (the Landing
    // page and the desktop updater depend on them). The ADMIN installer is
    // served exclusively by the baixarAppAdmin Cloud Function, which consumes
    // a short-lived token -- a public admin URL would leak the tool.
    match /apps/{fileName} {
      allow read, list: if fileName == 'version.json' || fileName == 'MercadoFacil-Usuario-Setup.exe';
      allow write: if isAdminPublicadora()
        && (fileName.matches('.*\\.exe$') || fileName == 'version.json')
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isAdminPublicadora();
    }

    // Safety fallback: deny any folder not listed above
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
