rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de produtos — qualquer usuário autenticado pode ler;
    // escrita apenas por administradores (role 'admin' no Firestore).
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /products/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024   // 2MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Arquivos privados por usuário — estrutura {pasta}/{uid}/{arquivo}:
    // leitura apenas do dono (ou admin); escrita apenas do dono.

    // Comprovantes de depósito (wallet_proofs) — até 8MB
    match /wallet_proofs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Documentos de identidade (cadastro) — até 8MB
    match /docs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if isAdmin();
    }

    // Comprovantes de pagamento PIX (pedidos) — até 8MB
    match /comprovantes_pix/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Comprovantes diversos — 5MB max (apenas imagens/PDF)
    match /receipts/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Regra de segurança (Fallback): bloqueia qualquer pasta não listada acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
