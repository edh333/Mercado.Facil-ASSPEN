rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de produtos — qualquer usuário autenticado pode ler;
    // escrita apenas por administradores (Custom Claims: admin == true).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        (firestore.exists(/databases/(default)/documents/users/$(uid)) &&
         firestore.get(/databases/(default)/documents/users/$(uid)).data.authUid == request.auth.uid)
      );
    }

    match /products/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024   // 2MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Arquivos privados por usuÃ¡rio â€” estrutura {pasta}/{uid}/{arquivo}:
    // leitura apenas do dono (ou admin); escrita apenas do dono.

    // Comprovantes de depÃ³sito (wallet_proofs) â€” atÃ© 8MB
    match /wallet_proofs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Documentos de identidade (cadastro) â€” atÃ© 8MB
    match /docs/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if isAdmin();
    }

    // Comprovantes de pagamento PIX (pedidos) â€” atÃ© 8MB
    match /comprovantes_pix/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 8 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Comprovantes diversos â€” 5MB max (apenas imagens/PDF)
    match /receipts/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|jpg|heic|heif)') || request.resource.contentType.matches('application/pdf'));
      allow delete: if false;
    }

    // Instaladores dos aplicativos desktop (pasta apps/) — públicos para LEITURA;
    // escrita/deleção APENAS por administradores (a função obterLinkDownloadApp
    // já filtra a versão por papel; a pasta não pode ser corrompida por
    // usuário comum — vetor de supply-chain).
    match /apps/{fileName} {
      allow read, list: if true;
      allow write: if isAdmin()
        && (fileName.matches('.*\\.exe$') || fileName == 'version.json')
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Regra de seguranÃ§a (Fallback): bloqueia qualquer pasta nÃ£o listada acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
